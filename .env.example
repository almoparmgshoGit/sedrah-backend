PORT=5000
NODE_ENV=production
JWT_SECRET=super_secure_jwt_secret_key_change_in_production_123456789
JWT_EXPIRES_IN=7d
DATABASE_URL=postgresql://sedrah_user:your_secure_password@localhost:5432/sedrah_db
# Browser origins of the admin and company web panels, comma separated (e.g. https://admin.sedrah.tech).
# "*" lets any website call the API. The mobile apps are not affected by this setting.
CORS_ORIGIN=*
# Proxies allowed to report the client IP (used by rate limiting). The default trusts nginx on the same host/network.
# TRUST_PROXY=loopback, linklocal, uniquelocal
# Base URL used for links to uploaded files (defaults to https://sedrah.tech in production)
PUBLIC_SERVER_URL=https://sedrah.tech
# Only used to create admin@sdra.com when it does not exist yet
ADMIN_INITIAL_PASSWORD=
